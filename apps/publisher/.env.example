# Copy to .env and fill in only the platforms you use. One developer app per
# platform is enough for all of your brands' accounts on that platform.

# Where each platform sends you back after login. Use the loopback address for
# X, LinkedIn and Google. Meta (Threads, Instagram) and TikTok only accept
# https, so for those set a page on one of your sites, e.g.
# https://app-one.example.com/oauth/callback, and paste the URL you land on.
OAUTH_REDIRECT_URI=http://localhost:8787/callback

X_CLIENT_ID=
X_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Monthly LinkedIn API version (YYYYMM). LinkedIn retires versions after about a year.
LINKEDIN_API_VERSION=202609

THREADS_APP_ID=
THREADS_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Cloud OAuth client (Desktop or Web) with the YouTube Data API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
